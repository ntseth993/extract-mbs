{
  "name": "smart-download-accelerator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Optimize legitimate downloads with adaptive parallel connections and reliable resume support.",
  "author": "Smart Download Accelerator",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "build:server": "node scripts/build-server.mjs",
    "desktop": "npm run build && npm run build:server && electron-builder",
    "desktop:dir": "npm run build && npm run build:server && electron-builder --dir",
    "check": "tsc --noEmit",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "vite": "^6.4.3",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.smartdownload.accelerator",
    "productName": "Smart Download Accelerator",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "dist-server/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
